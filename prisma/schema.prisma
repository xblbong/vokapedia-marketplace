generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==================== USER & AUTH ====================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SUPERVISOR") // ADMINISTRATOR, SUPERVISOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== CORE DATA ====================

model ProgramStudi {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String
  icon        String
  iconAlt     String       @default("")
  teamMembers TeamMember[]
  startups    Startup[]
}

model Startup {
  id             Int          @id @default(autoincrement())
  name           String
  slug           String       @unique
  description    String
  bannerImage    String       @default("")
  bannerAlt      String       @default("")
  profileImage   String       @default("")
  profileAlt     String       @default("")
  categoryId     Int?
  programStudiId Int?
  whatsappUrl    String?
  ecommerceUrl   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category       Category?    @relation(fields: [categoryId], references: [id])
  programStudi   ProgramStudi? @relation(fields: [programStudiId], references: [id])
  teamMembers    TeamMember[]
  products       Product[]
  views          StartupView[]
  buttonClicks   ButtonClick[] @relation("StartupClicks")
}

model TeamMember {
  id             Int          @id @default(autoincrement())
  name           String
  role           String
  photo          String       @default("")
  photoAlt       String       @default("")
  instagramUrl   String?      // Optional Instagram link
  startupId      Int
  programStudiId Int?

  startup        Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  programStudi   ProgramStudi? @relation(fields: [programStudiId], references: [id])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  startups Startup[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  price       Float    @default(0)
  stock       Int      @default(0)
  image       String   @default("")
  imageAlt    String   @default("")
  startupId   Int
  categoryId  Int
  ecommerceUrl String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startup      Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id])
  views        ProductView[]
  buttonClicks ButtonClick[] @relation("ProductClicks")
}

// ==================== ANALYTICS ====================

model PageView {
  id        Int      @id @default(autoincrement())
  page      String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ProductView {
  id        Int      @id @default(autoincrement())
  productId Int
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StartupView {
  id        Int      @id @default(autoincrement())
  startupId Int
  createdAt DateTime @default(now())

  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model ButtonClick {
  id        Int        @id @default(autoincrement())
  type      String     // WHATSAPP, ECOMMERCE
  productId Int?
  startupId Int?
  createdAt DateTime   @default(now())

  product   Product?   @relation("ProductClicks", fields: [productId], references: [id], onDelete: Cascade)
  startup   Startup?   @relation("StartupClicks", fields: [startupId], references: [id], onDelete: Cascade)
}

// ==================== BERITA & KONTEN ====================

model KategoriBerita {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  berita   Berita[]
}

model Berita {
  id              Int            @id @default(autoincrement())
  slug            String         @unique
  judul           String
  isi_berita      String
  gambar          String         @default("")
  gambarAlt       String         @default("")
  is_slider       Boolean        @default(false)
  section_type    String         @default("TERBARU") // TERBARU, PROGRAM, TEACHING_FACTORY
  status          String         @default("PUBLISHED") // DRAFT, PUBLISHED
  tags            String         @default("")
  kategoriId      Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  kategori        KategoriBerita @relation(fields: [kategoriId], references: [id])
}

// ==================== HALAMAN STATIS (PAGES) ====================

model Halaman {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== MENU OVERLAY ====================

model MenuOverlayItem {
  id          Int      @id @default(autoincrement())
  sectionName String   
  label       String   
  url         String   
  order       Int      @default(0)
}
